# ===================================================================
#  Comprehensive .gitignore for Python Data Science / ML Projects
#  Tailored for VS Code, PyCharm, and uv/venv environments
# ===================================================================

# ----------------------------
#  Virtual Environments
# ----------------------------
# Never commit your virtual environment. It contains local package installations
# and can differ between machines and operating systems.
# Your dependencies should be managed by `pyproject.toml` (and `uv.lock`).
.venv/
venv/
ENV/
env/
# In case virtualenvs are nested in subdirectories
*/.venv/
*/venv/

# ----------------------------
#  IDE and Editor Configuration
# ----------------------------
# These files store user-specific settings for layout, plugins, debugging, etc.
# Ignoring them prevents overriding collaborators' personal setups.

# VS Code
.vscode/

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Other generic editor files
*.swp
*~
*.bak

# ----------------------------
#  Python Cache & Artifacts
# ----------------------------
# Python generates these files during runtime or packaging.
# They are not part of the source code and can be regenerated.

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ----------------------------
#  Project-Specific Files
# ----------------------------
# Data, logs, and outputs that are generated by your analysis scripts.

# Large data files
# It's bad practice to commit large datasets to Git.
# If your dataset (e.g., MLBOOK_DATA.xlsx) is small and essential for
# reproducibility, you can remove it from this list or use `git add -f`.
data/
outputs/
results/
*.csv
*.json
*.parquet
*.db
*.sqlite3

# Log files
*.log
*.log.*

# Generated reports or plots
*.html
*.png
*.jpg
*.svg

# ----------------------------
#  Testing & Coverage Reports
# ----------------------------
# Files generated by testing frameworks like pytest or coverage tools.

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ----------------------------
#  Jupyter Notebook Checkpoints
# ----------------------------
# Jupyter automatically creates these checkpoint files.

.ipynb_checkpoints/

# ----------------------------
#  Secrets & Credentials
# ----------------------------
# CRITICAL: Never, ever commit secrets, API keys, or passwords!
# Keep them in an ignored .env file and provide an example template.

.env
.env.*
# But DO commit an example file to show what variables are needed
!/.env.example
!/.env.template

credentials.json
secrets.ini
config.ini

# ----------------------------
#  OS-specific files
# ----------------------------
# Annoying files generated by macOS, Windows, and Linux.

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

